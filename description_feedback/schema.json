{
  "customers": {
    "description": "One row per registered customer account.",
    "columns": [
      {"name": "cust_id",      "dtype": "string",  "samples": ["C1001", "C1002", "C1003"]},
      {"name": "full_name",    "dtype": "string",  "samples": ["Ada Lovelace", "Rahul Menon"]},
      {"name": "signup_date",  "dtype": "date",    "samples": ["2024-01-14", "2024-06-02"]},
      {"name": "country_code", "dtype": "string",  "samples": ["IN", "US", "DE"]}
    ]
  },
  "orders": {
    "description": "One row per placed order, across all sales channels.",
    "columns": [
      {"name": "order_id",     "dtype": "string",  "samples": ["O-88412", "O-88413"]},
      {"name": "cust_id",      "dtype": "string",  "samples": ["C1001", "C1002"]},
      {"name": "order_ts",     "dtype": "timestamp", "samples": ["2024-07-01T09:14:22Z"]},
      {"name": "total_amount", "dtype": "decimal", "samples": [1499.0, 230.5, 8710.25]}
    ]
  },
  "order_items": {
    "description": "Line items belonging to an order. One row per SKU per order.",
    "columns": [
      {"name": "order_id",   "dtype": "string",  "samples": ["O-88412", "O-88412"]},
      {"name": "sku",        "dtype": "string",  "samples": ["SKU-4417", "SKU-9002"]},
      {"name": "qty",        "dtype": "integer", "samples": [1, 3, 12]},
      {"name": "unit_price", "dtype": "decimal", "samples": [499.0, 76.5]}
    ]
  },
  "products": {
    "description": "Product catalogue. One row per sellable SKU.",
    "columns": [
      {"name": "sku",       "dtype": "string",  "samples": ["SKU-4417", "SKU-9002"]},
      {"name": "title",     "dtype": "string",  "samples": ["Cotton Crew Tee", "Steel Water Bottle"]},
      {"name": "category",  "dtype": "string",  "samples": ["apparel", "drinkware"]},
      {"name": "weight_kg", "dtype": "decimal", "samples": [0.18, 0.42, 1.05]}
    ]
  },
  "payments": {
    "description": "Payment attempts against orders, including retries.",
    "columns": [
      {"name": "payment_id", "dtype": "string",  "samples": ["P-20031", "P-20032"]},
      {"name": "order_id",   "dtype": "string",  "samples": ["O-88412", "O-88413"]},
      {"name": "amount",     "dtype": "decimal", "samples": [1499.0, 230.5]},
      {"name": "method",     "dtype": "string",  "samples": ["upi", "card", "netbanking"]}
    ]
  }
}
